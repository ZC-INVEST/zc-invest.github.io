# À saisir dans les variables d'environnement de Render / Railway — JAMAIS sur GitHub
TWELVEDATA_API_KEY=ta_cle_api_ici

# Comptes membres : ligne générée par  node hash-password.js identifiant motdepasse
# (plusieurs comptes séparés par des virgules)
USERS=zcinvest:scrypt:SEL:HASH

# Secret de signature des sessions (longue chaîne aléatoire)
AUTH_SECRET=une_longue_chaine_aleatoire
SESSION_HOURS=12

ALLOWED_ORIGIN=https://www.zcinvest.co.uk,https://zc-invest.github.io
SYMBOLS=EUR/USD,GBP/USD,USD/JPY,XAU/USD
TIMEFRAMES=15min,1h,4h
USE_WEBSOCKET=false
CREDITS_PER_MIN=8
DAILY_CREDITS=800
ALERT_MIN_SCORE=60
